terraform {
  required_version = ">= 1.11"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

#Look up your AWS account ID (used to make the bucket name unique)
data "aws_caller_identity" "current" {}